<h2>Cadastrar Artista</h2>

<form action="/artistas" method="POST">

    <label for="nome">
        Nome:
    </label>

    <input
        type="text"
        id="nome"
        name="nome"
        required
    >

    <label for="pais">
        País:
    </label>

    <input
        type="text"
        id="pais"
        name="pais"
        required
    >

    <button type="submit">
        Cadastrar
    </button>

</form>